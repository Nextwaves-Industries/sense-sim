+/// What the application bar would have opened, for a host that draws the bars itself.
+pub fn host_menus(app: &mut SolveApp, ui: &mut egui::Ui) {
+    file_menu(app, ui.ctx());
+}
+
+/// Opens or closes the File menu, at `x` along the top of this UI, for a host's own button.
+pub fn toggle_file_menu(app: &mut SolveApp, ctx: &egui::Context, x: f32) {
+    app.ui.palette_open = false;
+    let open = file_menu_open(ctx);
+    let pass = ctx.cumulative_pass_nr();
+    ctx.data_mut(|d| {
+        d.insert_temp(egui::Id::new("sc_file_menu"), !open);
+        d.insert_temp(egui::Id::new("sc_file_menu_opened"), pass);
+        d.insert_temp(egui::Id::new("sc_file_menu_x"), x);
+    });
+}
+
+/// Whether the File menu shows.
+pub fn file_menu_open(ctx: &egui::Context) -> bool {
+    ctx.data(|d| d.get_temp::<bool>(egui::Id::new("sc_file_menu")).unwrap_or(false))
+}
+
+/// Closes the File menu: a host saw a click outside this UI, which never reaches the menu.
+pub fn close_file_menu(ctx: &egui::Context) {
+    ctx.data_mut(|d| d.insert_temp(egui::Id::new("sc_file_menu"), false));
+}
